rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'clamontpatrick@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['name', 'email', 'isVipWaitlist']) &&
        data.keys().hasOnly(['name', 'email', 'isVipWaitlist', 'selectedFormats', 'source', 'createdAt']) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 100 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 150 &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.isVipWaitlist is bool &&
        (!('selectedFormats' in data) || (
          data.selectedFormats is list &&
          data.selectedFormats.size() <= 10 &&
          (data.selectedFormats.size() == 0 || data.selectedFormats[0] is string)
        )) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Subscribers collection:
    // - Public visitors can submit signup forms (validated strictly by isValidSubscriber)
    // - Only verified admin (clamontpatrick@gmail.com) can read, list, or delete subscriber records
    match /subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow get, list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && isValidId(subscriberId);
    }
  }
}
