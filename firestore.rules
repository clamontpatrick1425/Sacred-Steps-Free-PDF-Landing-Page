rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['name', 'email', 'isVipWaitlist']) &&
        data.keys().hasOnly(['name', 'email', 'isVipWaitlist', 'selectedFormats', 'source', 'createdAt']) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 100 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 150 &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.isVipWaitlist is bool &&
        (!('selectedFormats' in data) || (data.selectedFormats is list && data.selectedFormats.size() <= 10)) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Subscribers collection: Allows creation with strict schema validation
    // PII Protection: Public listing and reading is strictly forbidden to prevent data scraping
    match /subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) && isValidSubscriber(incoming());
      allow read, update, delete: if false;
    }
  }
}
